interface DtcHandler {
  --
  + {abstract} SetTemporarySwErrorPrimaryDtc(state: DTCState): bool
  + {abstract} SetCalibrationIntegrityErrorSecondaryDtc(state: DTCState): bool
  + {abstract} SetCalibrationDefaultValueInUseSecondaryDtc(state: DTCState): bool
  + {abstract} SetCalibrationValuesChangedPrimaryDtc(state: DTCState): bool
}

enum DTCState <<std::uint8_t>> {
  kPassed
  kFailed
  kFailedPermanent
}

class DtcHandlerImpl {
  --
  - secondary_dtc_calibration_integrity_error_: score::mw::diag::dtc::DTC
  - dtc_calibration_default_value_in_use_: score::mw::diag::dtc::DTC
  - dtc_calibration_values_changed_: score::mw::diag::dtc::DTC
  - fault_event_reporter_: fault_event_reporter::IFaultEventReporter
  --
  + DtcHandlerImpl(secondary_dtc_calibration_integrity_error: score::mw::diag::dtc::DTC,
    dtc_calibration_default_value_in_use: score::mw::diag::dtc::DTC,
    dtc_calibration_values_changed: score::mw::diag::dtc::DTC,
    fault_event_reporter: fault_event_reporter::IFaultEventReporter)
  + SetTemporarySwErrorPrimaryDtc(state: DTCState): bool
  + SetCalibrationIntegrityErrorSecondaryDtc(state: DTCState): bool
  + SetCalibrationDefaultValueInUseSecondaryDtc(state: DTCState): bool
  + SetCalibrationValuesChangedPrimaryDtc(state: DTCState): bool
  --
  Responsibilities: Handle the ConfigDaemon DTCs.
  Mutex is used to guard shared resource - DTC monitor.
}

