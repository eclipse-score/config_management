build --java_language_version=17
build --tool_java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17

# Unset ANDROID_HOME to prevent rules_android from searching for the Android SDK.
# rules_android is a transitive dependency, and on GitHub runners the Android SDK
# directory is often deleted while the ANDROID_HOME environment variable remains set.
common --action_env=ANDROID_HOME=""

test --test_output=errors

common --@score_baselibs//score/json:base_library=nlohmann
common --@score_baselibs//score/analysis/tracing/generic_trace_library:implementation=@score_baselibs//score/analysis/tracing/generic_trace_library/stub_implementation
common --//score/config_management/config_daemon/code:score_variant=True
common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
common --registry=https://bcr.bazel.build

# libclang toolchain for the C++ parser used by score_tooling unit() rules
common --extra_toolchains=//bazel/toolchains:score_config_management_libclang_toolchain

# Host GCC toolchain — used by CI (tests.yml, static-analysis.yml)
# score_bazel_cpp_toolchains gcc module extension generates @score_gcc_x86_64_toolchain
build:host_gcc --extra_toolchains=@score_gcc_x86_64_toolchain//:x86_64-linux-gcc_12.2.0
build:host_gcc --host_platform=@score_bazel_platforms//:x86_64-linux
# Set target platform to gcc_12.2.0-posix so GCC toolchain's target_compatible_with
# constraint is satisfied and GCC is actually selected (LLVM is the default otherwise).
build:host_gcc --platforms=@score_bazel_platforms//:x86_64-linux-gcc_12.2.0-posix

# score_baselibs deprecated StringLiteral but still uses it in many headers
# (string_comparison_adaptor.h, text_format.h, etc.). These headers are included
# transitively by our own code, so the -Werror,-Wdeprecated-declarations error
# fires in ALL translation units that pull in score/json or score/mw/log.
# score_baselibs' own CI uses GCC (dev_dependency toolchain) which doesn't
# treat deprecated-declarations as errors. Suppress globally until upstream
# removes the deprecated usages from their public headers.
build --copt=-Wno-deprecated-declarations
# Same flag for exec/tool configurations (unit() rule compiles test binaries as
# tools; score_lifecycle also uses the deprecated StringLiteral there).
build --host_copt=-Wno-deprecated-declarations
# score_logging commit 3ad4fab (May 15) introduced an unused 'result' variable in
# data_router_message_client_impl.cpp (PThreadBlockSigTerm return value discarded).
# No upstream fix exists yet. Suppress -Wunused-variable for all external/ source
# files (does NOT affect our own code in score/ or tests/).
build --per_file_copt=external/.*@-Wno-unused-variable
# Same for exec/tool configuration builds triggered by unit() rules.
build --host_per_file_copt=external/.*@-Wno-unused-variable

coverage --features=coverage
coverage --combined_report=lcov
coverage --cache_test_results=no
coverage --copt=-fprofile-update=atomic
coverage --linkopt=-fprofile-update=atomic

# QNX credential helper — downloads QCC from qnx.com using SCORE_QNX_USER / SCORE_QNX_PASSWORD
# env vars (set in CI secrets) or ~/.netrc (for local builds with a QNX account)
build --credential_helper=*.qnx.com=%workspace%/scripts/internal/qnx_creds.py
build --credential_helper_timeout=60s

# Common flags for QNX cross-compilation
# Sets Ferrocene as the host Rust toolchain so proc-macro crates stay ABI-compatible
build:toolchain_common --incompatible_strict_action_env
build:toolchain_common --host_platform=@score_bazel_platforms//:x86_64-linux
build:toolchain_common --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu

# Disables remote DLT transport (not available inside QEMU unit test environment)
build:stub --@score_baselibs//score/mw/log/flags:KRemote_Logging=False

# Target configuration: QNX x86_64 (QEMU native speed)
build:x86_64-qnx --config=stub
build:x86_64-qnx --config=toolchain_common
build:x86_64-qnx --platforms=@score_bazel_platforms//:x86_64-qnx-sdp_8.0.0-posix
build:x86_64-qnx --extra_toolchains=@score_qcc_x86_64_toolchain//:x86_64-qnx-sdp_8.0.0
build:x86_64-qnx --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_pc_nto_qnx800
build:x86_64-qnx --extra_toolchains=@score_qnx_x86_64_ifs_toolchain//:ifs-x86_64-qnx-sdp_8.0.0
test:x86_64-qnx --run_under=@score_qnx_unit_tests//src:run_under_qnx
test:x86_64-qnx --test_lang_filters=cc,rust

# Target configuration: QNX aarch64 (QEMU emulation — slower, extended timeouts needed)
build:arm64-qnx --config=stub
build:arm64-qnx --config=toolchain_common
build:arm64-qnx --incompatible_strict_action_env
build:arm64-qnx --platforms=@score_bazel_platforms//:aarch64-qnx-sdp_8.0.0-posix
build:arm64-qnx --extra_toolchains=@score_qcc_aarch64_toolchain//:aarch64-qnx-sdp_8.0.0
build:arm64-qnx --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_aarch64_unknown_nto_qnx800
build:arm64-qnx --extra_toolchains=@score_qnx_aarch64_ifs_toolchain//:ifs-aarch64-qnx-sdp_8.0.0
test:arm64-qnx --run_under=@score_qnx_unit_tests//src:run_under_qnx
test:arm64-qnx --test_timeout=300
test:arm64-qnx --test_lang_filters=cc,rust
