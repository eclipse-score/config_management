# LLVM source-based coverage (C++) via @score_coverage (the qualified S-CORE coverage
# tool), guide: https://eclipse-score.github.io/coverage_tool/main/manual/user_manual.html
# Use with: bazel coverage --config=llvm_cov <test targets> --build_tests_only
#
# Do NOT combine with --config=host_gcc: the last --extra_toolchains wins
# resolution and GCC produces no LLVM covmap. The repo has no Bazel Rust
# targets today; when Rust lands, add the Ferrocene toolchain and the
# rustc coverage flags here (see other S-CORE adoptions).

# The scope target lists ~17 production libraries whose visibility is
# restricted to their own subtrees (CI builds them as top-level targets,
# which bypasses visibility; a deps edge does not). Granting visibility on
# all of them would touch a dozen team-owned BUILD files, so visibility
# checking is disabled for the coverage config ONLY - the scope aggregator
# never links these targets, and every regular build/test job still
# enforces visibility.
coverage:llvm_cov --check_visibility=false

coverage:llvm_cov --nocache_test_results
# Instrument everything under //score. Left unset, Bazel guesses the filter from the
# packages of the test targets (stripping only a trailing "/tests"); a library tested from
# a "test" subpackage is then compiled without counters unless one of its deps happens to
# be instrumented (score_coverage 0.3.1, user manual step 4).
coverage:llvm_cov --instrumentation_filter=^//score[/:]

coverage:llvm_cov --cxxopt=-O0
coverage:llvm_cov --combined_report=lcov
coverage:llvm_cov --experimental_fetch_all_coverage_outputs
coverage:llvm_cov --dynamic_mode=off
coverage:llvm_cov --experimental_generate_llvm_lcov
coverage:llvm_cov --experimental_use_llvm_covmap

# Coverage-only Clang 22 instance (regular builds keep the default 19.1.0).
coverage:llvm_cov --extra_toolchains=@llvm_toolchain_coverage//:cc-toolchain-x86_64-linux

coverage:llvm_cov --coverage_output_generator=@score_coverage//:merger
coverage:llvm_cov --coverage_report_generator=//tools/coverage:reporter_wrapper
coverage:llvm_cov --test_env=GENERATE_LLVM_LCOV=0
coverage:llvm_cov --test_env=COVERAGE_GCOV_PATH=/usr/bin/true
coverage:llvm_cov --test_env=LLVM_PROFILE_CONTINUOUS_MODE=1
coverage:llvm_cov --features=enable_llvm_coverage_for_death_tests
coverage:llvm_cov --features=coverage

# Headers of libraries with `includes = [...]` (score_kvs_stub) reach clang as -isystem, and
# clang records no coverage for functions defined in system headers. The flag turns that
# exclusion off; the real system headers it also instruments stay out of the report through
# the scope (score_coverage >= 0.4.1, user manual "Headers published through includes").
coverage:llvm_cov --copt=-mllvm --copt=-system-headers-coverage
